# ============================================================
#  Copie para .env (o setup.sh faz isso) e preencha SÓ esta parte:
# ============================================================

# Login usado em TODOS os serviços (Jellyfin, Seerr, Radarr, Sonarr, Prowlarr, Deluge)
STACK_USER=admin
STACK_PASSWORD=
STACK_EMAIL=admin@example.com

# Onde ficam downloads + biblioteca (precisa de espaço!)
DATA_ROOT=./data

# Portas no host (mude se alguma já estiver em uso)
JELLYFIN_PORT=8096
SEERR_PORT=5055
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
DELUGE_PORT=8112
BAZARR_PORT=6767
PAINEL_PORT=8585

# Legendas (opcional, melhora MUITO a cobertura pt-BR). Contas gratuitas:
#   opensubtitles.com  |  subdl.com (API key no painel)  |  legendas.net
OPENSUBTITLES_USER=
OPENSUBTITLES_PASSWORD=
SUBDL_API_KEY=
LEGENDASNET_USER=
LEGENDASNET_PASSWORD=

# Avisos no Telegram quando um pedido fica pronto (opcional). Como obter:
#   1. No Telegram, fale com @BotFather > /newbot > copie o token
#   2. Mande qualquer mensagem pro seu bot e abra https://api.telegram.org/bot<TOKEN>/getUpdates
#      O número em "chat":{"id": ...} é o TELEGRAM_CHAT_ID (pode ser um grupo da família)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Assistir de fora de casa pelo Tailscale (opcional, grátis para uso pessoal). Como obter:
#   1. Crie a conta em tailscale.com e instale o app no celular/TV/notebook
#   2. Painel > DNS: ligue "MagicDNS" e "HTTPS Certificates"
#   3. Painel > Settings > Keys > "Generate auth key" (deixe "Reusable" desligado) e cole aqui
#   Depois: ./setup.sh. Endereços: https://locadora.<sua-rede>.ts.net (Jellyfin) e :8443 (Seerr)
TS_AUTHKEY=

# Painel (http://localhost:8585): configurações, atualizar e backups pelo navegador usam o
# serviço "operador", que tem acesso ao Docker. Para deixar o painel só com pessoas e diagnóstico: off
PAINEL_MANUTENCAO=

# Limpeza automática: tira os filmes que TODO MUNDO já viu há este tanto de dias (vazio = desligada).
# Favoritos (❤️ no Jellyfin) nunca saem. Avisa no Telegram 3 dias antes. Simular: ./limpeza.sh
LIMPEZA_DIAS=

# ============================================================
#  O resto o setup.sh preenche sozinho
# ============================================================
TZ=
PUID=
PGID=
RENDER_GID=
VIDEO_GID=
HAS_GPU=0
COMPOSE_FILE=docker-compose.yml

# Chaves de API internas (geradas aleatoriamente)
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
